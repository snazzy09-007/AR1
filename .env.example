# OBLIGATOIRE — chaîne PostgreSQL poolée fournie par Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# OPTIONNEL — URL canonique. Inutile sur Vercel : elle est détectée automatiquement.
# NEXT_PUBLIC_APP_URL=https://ton-projet.vercel.app

# OPTIONNEL — clé globale pour les anciens agents configurés manuellement.
# Les launchers « 1 clic » utilisent un token individuel et n'en ont pas besoin.
# AGENT_SECRET=une-longue-cle-aleatoire
